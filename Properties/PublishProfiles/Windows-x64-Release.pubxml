<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <StagedPublishDirectory>$(MSBuildProjectDirectory)\obj\publish\Windows-x64-Release</StagedPublishDirectory>
    <StagedSettingsDirectory>$(MSBuildProjectDirectory)\obj\publish\Windows-x64-Release-settings</StagedSettingsDirectory>
    <InstalledVitalsDirectory>$(LOCALAPPDATA)\Vitals</InstalledVitalsDirectory>
    <PublishDir>$(StagedPublishDirectory)\</PublishDir>
    <PublishUrl>$(InstalledVitalsDirectory)\</PublishUrl>
  </PropertyGroup>

  <!-- The AOT executable is locked while Vitals is running. Publish to obj
       first, then install and restart only after the compiler is finished. -->
  <Target Name="PublishVitalsSettingsBeforeInstall" BeforeTargets="RestartInstalledVitalsAfterPublish">
    <MSBuild Projects="$(MSBuildProjectDirectory)\Vitals.Settings\Vitals.Settings.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(StagedSettingsDirectory)\;PublishUrl=$(StagedSettingsDirectory)\;SelfContained=false;PublishProfile=" />
  </Target>

  <Target Name="RestartInstalledVitalsAfterPublish" AfterTargets="Publish">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\RestartVitalsAfterPublish.ps1&quot; -StagedPublishDirectory &quot;$(StagedPublishDirectory)&quot; -StagedSettingsDirectory &quot;$(StagedSettingsDirectory)&quot; -InstalledDirectory &quot;$(InstalledVitalsDirectory)&quot;" />
  </Target>
</Project>
