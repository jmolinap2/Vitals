<Window x:Class="Vitals.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de Vitals" Height="640" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116"
        Icon="vitals.ico"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A97A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B6EF5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D7DF7"/>
        <SolidColorBrush x:Key="RowBrush" Color="#171A21"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1D212A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#262B35"/>

        <Style TargetType="Button" x:Key="StepButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1F242E" CornerRadius="6"
                                Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3340"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="7"
                                Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="19" Height="19" CornerRadius="5"
                                Background="#222833" BorderBrush="#39414F" BorderThickness="1.2">
                            <Path x:Name="Check" Data="M 3,7.5 L 6.5,11 L 13,3.5"
                                  Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" x:Key="SizeSlider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="26">
                            <Border Height="5" CornerRadius="2.5" Background="#242A35" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}"
                                                         Stroke="White" StrokeThickness="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sección plegable: cabecera con título + flecha, cuerpo oculto
             hasta que se expande. La flecha vive dentro del propio template
             del ToggleButton para poder rotarla con un trigger local. -->
        <Style TargetType="Expander" x:Key="SectionExpander">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource RowBrush}" CornerRadius="9" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent" Margin="14,13">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="14.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Chevron" Text="&#x25BE;"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#x25B4;"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="ContentHost" Visibility="Collapsed">
                                    <ContentPresenter Margin="14,0,14,14"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ToggleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Ajustes" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Los cambios se aplican al instante, sin reiniciar Vitals."
                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Expander Header="Tamaño" IsExpanded="True" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SliderBlock}">
                            <Grid>
                                <TextBlock Text="Tamaño de la píldora" Foreground="{StaticResource TextBrush}"
                                           FontSize="13.5" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                    <TextBlock x:Name="ScaleReadout" Text="100%" Foreground="{StaticResource TextBrush}"
                                               FontSize="12" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="ScaleSlider" Style="{StaticResource SizeSlider}"
                                    Minimum="0.6" Maximum="2.0" Value="1.0"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Margin="0,10,0,2"
                                    ValueChanged="ScaleSlider_ValueChanged"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="60%" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="200%" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Ancho de columna" Foreground="{StaticResource TextBrush}"
                                           FontSize="13.5" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                    <TextBlock x:Name="WidthReadout" Text="96 px" Foreground="{StaticResource TextBrush}"
                                               FontSize="12" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="WidthSlider" Style="{StaticResource SizeSlider}"
                                    Minimum="62" Maximum="130" Value="96"
                                    IsSnapToTickEnabled="True" TickFrequency="2"
                                    Margin="0,10,0,2"
                                    ValueChanged="WidthSlider_ValueChanged"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="compacto" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="amplio" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="Apariencia" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SliderBlock}">
                            <Grid>
                                <TextBlock Text="Opacidad" Foreground="{StaticResource TextBrush}"
                                           FontSize="13.5" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                    <TextBlock x:Name="OpacityReadout" Text="95%" Foreground="{StaticResource TextBrush}"
                                               FontSize="12" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource SizeSlider}"
                                    Minimum="0.25" Maximum="1.0" Value="0.95"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Margin="0,10,0,2"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="25%" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="100%" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Grid Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <TextBlock Text="Gráficas de historial" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                <TextBlock Text="Al apagarlas la píldora queda compacta." FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChartsCheck" IsChecked="True" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Colores de alerta" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                <TextBlock Text="CPU/GPU/RAM en ámbar y rojo al saturarse; batería al agotarse." FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="AlertCheck" IsChecked="True" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Rendimiento" Style="{StaticResource SectionExpander}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Transiciones suaves" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                            <TextBlock Text="Apagarlas reduce el repintado de ~11 a 1 por segundo." FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SmoothCheck" IsChecked="True" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Expander>

                <Expander Header="Métricas" IsExpanded="True" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                        <TextBlock Text="Activa las que quieras ver y ordénalas con las flechas."
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <ItemsControl x:Name="MetricsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder" Background="{StaticResource RowHoverBrush}" CornerRadius="8"
                                            Margin="0,0,0,6" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0" Data="{Binding IconGeometry}"
                                                  Stroke="{Binding AccentBrush}" StrokeThickness="1.5"
                                                  Width="18" Height="18" Stretch="Uniform"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  StrokeLineJoin="Round"/>

                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <TextBlock Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" FontSize="14"/>

                                            <Button Grid.Column="4" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource StepButton}" Click="MoveUp_Click" Margin="0,0,6,0"
                                                    ToolTip="Subir"/>
                                            <Button Grid.Column="5" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource StepButton}" Click="MoveDown_Click"
                                                    ToolTip="Bajar"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="0,14,0,0" Margin="0,10,0,0">
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Click="Save_Click"/>
        </Border>
    </Grid>
</Window>
