<Window x:Class="Vitals.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de Vitals" Height="740" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116"
        Icon="vitals.ico"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A97A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2AD1BE"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3FE0CE"/>
        <SolidColorBrush x:Key="RowBrush" Color="#171A21"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1D212A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#262B35"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0B0D12"/>

        <Style TargetType="Button" x:Key="StepButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1F242E" CornerRadius="6" Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3340"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="#04211D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="7" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#2A303B" BorderThickness="1.2"
                                CornerRadius="7" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="CheckMark">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="19" Height="19" CornerRadius="5"
                                Background="#222833" BorderBrush="#39414F" BorderThickness="1.2">
                            <Path x:Name="Check" Data="M 3,7.5 L 6.5,11 L 13,3.5"
                                  Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor tipo píldora, para las opciones de Comportamiento/Apariencia. -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#2A303B">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" x:Key="SizeSlider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="26">
                            <Border Height="5" CornerRadius="2.5" Background="#242A35" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}"
                                                         Stroke="White" StrokeThickness="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de esquina (3x3) para elegir en qué borde vive la píldora. -->
        <Style TargetType="RadioButton" x:Key="CornerButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1F242E" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3340"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#04211D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastilla de color redonda, para la paleta del popup y el swatch de cada fila. -->
        <Style x:Key="PaletteSwatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}"
                                 Stroke="#3A4150" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="18" Height="18" Fill="{Binding AccentBrush}"
                                 Stroke="#3A4150" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de esquema de color (Neón/Clásico/Pastel/Monocromo). -->
        <Style x:Key="SchemeButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="#1B2028" BorderBrush="#2A303B"
                                BorderThickness="1.4" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#122C29"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20262F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elemento de navegación de la barra lateral: ícono + título + subtítulo
             (el subtítulo viaja en ToolTip y el glifo del ícono en Tag, para no
             necesitar propiedades adjuntas propias). -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Padding="10,9" Margin="0,0,0,3">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="IconBd" Width="32" Height="32" CornerRadius="8" Background="#1B2028">
                                    <TextBlock x:Name="IconTb" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleTb" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{TemplateBinding ToolTip}" FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161A21"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12332E"/>
                                <Setter TargetName="IconBd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="IconTb" Property="Foreground" Value="#04211D"/>
                                <Setter TargetName="TitleTb" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RowBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SliderBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ToggleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="vitals.ico" Width="26" Height="26"/>
                    <TextBlock Text="Ajustes de Vitals" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavGeneral" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="General" Tag="&#xE713;" ToolTip="Apariencia y comportamiento"
                                 IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMetricas" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Métricas" Tag="&#xE8FD;" ToolTip="Qué mostrar y cómo" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRendimiento" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Rendimiento" Tag="&#xE7A5;" ToolTip="Gráficos e historial" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPosicion" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Posición" Tag="&#xE707;" ToolTip="En pantalla" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAlertas" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Alertas" Tag="&#xE789;" ToolTip="Umbrales y notificaciones" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAccesos" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Accesos rápidos" Tag="&#xE92E;" ToolTip="Teclas y atajos" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAcerca" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Acerca de" Tag="&#xE946;" ToolTip="Info de Vitals" Checked="Nav_Checked"/>
                </StackPanel>

                <Button Grid.Row="2" Content="Restablecer valores" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Click="ResetDefaults_Click"/>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" x:Name="PageHeader">
                    <TextBlock x:Name="PageTitle" Text="General" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Personaliza la apariencia y comportamiento de la píldora de Vitals."
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Vista previa" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" Margin="0,0,0,8"/>
                    <Border x:Name="PreviewPill" Background="Black" CornerRadius="22" Padding="16,10"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            Opacity="{Binding Value, ElementName=OpacitySlider}">
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Value, ElementName=ScaleSlider}"
                                            ScaleY="{Binding Value, ElementName=ScaleSlider}"/>
                        </Border.LayoutTransform>
                        <ItemsControl x:Name="PreviewMetrics">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="9,0" HorizontalAlignment="Center"
                                                Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{Binding IconGeometry}" Stroke="{Binding AccentBrush}" StrokeThickness="1.5"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DemoValue}" Foreground="{Binding AccentBrush}" FontSize="13"
                                                   FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid>

                <!-- ================= General ================= -->
                <Grid x:Name="PageGeneral">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tamaño" Style="{StaticResource CardTitle}"/>
                                <StackPanel Style="{StaticResource SliderBlock}">
                                    <Grid>
                                        <TextBlock Text="Tamaño de la píldora" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                            <TextBlock x:Name="ScaleReadout" Text="100%" Foreground="{StaticResource TextBrush}" FontSize="12" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource SizeSlider}" Minimum="0.6" Maximum="1.5"
                                            Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.05" Margin="0,10,0,2"
                                            ValueChanged="ScaleSlider_ValueChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Ancho de columna" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                            <TextBlock x:Name="WidthReadout" Text="96 px" Foreground="{StaticResource TextBrush}" FontSize="12" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="WidthSlider" Style="{StaticResource SizeSlider}" Minimum="78" Maximum="130"
                                            Value="96" IsSnapToTickEnabled="True" TickFrequency="2" Margin="0,10,0,2"
                                            ValueChanged="WidthSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Comportamiento" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource ToggleRow}">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar al iniciar Windows" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <TextBlock Text="La píldora se mostrará automáticamente." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Style="{StaticResource ToggleRow}">
                                    <StackPanel>
                                        <TextBlock Text="Ocultar automáticamente" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Se oculta cuando estás en pantalla completa." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoHideCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Click atraviesa (passthrough)" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Permite interactuar con ventanas detrás de la píldora." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ClickThroughCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Apariencia" Style="{StaticResource CardTitle}"/>
                                <StackPanel Style="{StaticResource SliderBlock}">
                                    <Grid>
                                        <TextBlock Text="Tamaño de letra" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                            <TextBlock x:Name="FontReadout" Text="100%" Foreground="{StaticResource TextBrush}" FontSize="12" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="FontSlider" Style="{StaticResource SizeSlider}" Minimum="0.7" Maximum="1.3"
                                            Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.05" Margin="0,10,0,2"
                                            ValueChanged="FontSlider_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SliderBlock}">
                                    <Grid>
                                        <TextBlock Text="Opacidad" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                        <Border HorizontalAlignment="Right" Background="#222833" CornerRadius="5" Padding="8,3">
                                            <TextBlock x:Name="OpacityReadout" Text="95%" Foreground="{StaticResource TextBrush}" FontSize="12" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource SizeSlider}" Minimum="0.25" Maximum="1.0"
                                            Value="0.95" IsSnapToTickEnabled="True" TickFrequency="0.05" Margin="0,10,0,2"
                                            ValueChanged="OpacitySlider_ValueChanged"/>
                                </StackPanel>
                                <TextBlock Text="Esquema de color" Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,3"/>
                                <TextBlock Text="Aplica una paleta a todas las métricas de una vez." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2" Rows="2">
                                    <RadioButton x:Name="SchemeNeon" GroupName="Scheme" Style="{StaticResource SchemeButton}"
                                                 Tag="Neon" Click="SchemePreset_Click" IsChecked="True" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#4D8CFF" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#3DD67D" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#A87FFF" Margin="0,0,7,0"/>
                                            <TextBlock Text="Neón" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="SchemeClasico" GroupName="Scheme" Style="{StaticResource SchemeButton}"
                                                 Tag="Classic" Click="SchemePreset_Click" Margin="6,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#6B8CAE" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#6BAE8C" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#9B8CAE" Margin="0,0,7,0"/>
                                            <TextBlock Text="Clásico" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="SchemePastel" GroupName="Scheme" Style="{StaticResource SchemeButton}"
                                                 Tag="Pastel" Click="SchemePreset_Click" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#A8C5FF" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#A8F0C5" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#D4C2FF" Margin="0,0,7,0"/>
                                            <TextBlock Text="Pastel" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="SchemeMono" GroupName="Scheme" Style="{StaticResource SchemeButton}"
                                                 Tag="Monochrome" Click="SchemePreset_Click" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#DDDDDD" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#DDDDDD" Margin="0,0,3,0"/>
                                            <Ellipse Width="10" Height="10" Fill="#DDDDDD" Margin="0,0,7,0"/>
                                            <TextBlock Text="Monocromo" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= Métricas ================= -->
                <StackPanel x:Name="PageMetricas" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Métricas visibles" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Actívalas, ordénalas con las flechas y toca el círculo para cambiar su color."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,-8,0,12" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="MetricsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RowHoverBrush}" CornerRadius="8" Margin="0,0,0,6" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0" Data="{Binding IconGeometry}" Stroke="{Binding AccentBrush}" StrokeThickness="1.5"
                                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" StrokeLineJoin="Round"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource CheckMark}" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Click="ColorSwatch_Click"
                                                        VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Cambiar color"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" FontSize="14"/>
                                                <Button Grid.Column="4" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StepButton}"
                                                        Click="MoveUp_Click" Margin="0,0,6,0" ToolTip="Subir"/>
                                                <Button Grid.Column="5" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StepButton}"
                                                        Click="MoveDown_Click" ToolTip="Bajar"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Rendimiento ================= -->
                <StackPanel x:Name="PageRendimiento" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gráficos e historial" Style="{StaticResource CardTitle}"/>
                            <Grid Style="{StaticResource ToggleRow}">
                                <StackPanel>
                                    <TextBlock Text="Gráficas de historial" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="Mini gráficos con el historial reciente. Al apagarlas la píldora queda compacta."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ChartsCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Transiciones suaves" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="Apagarlas reduce el repintado de ~11 a 1 por segundo." FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="SmoothCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Posición ================= -->
                <StackPanel x:Name="PagePosicion" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Posición en pantalla" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Elige dónde se mostrará la píldora." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,-8,0,16"/>
                            <Grid Width="220" Height="150" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="PosTopLeft" Grid.Row="0" Grid.Column="0" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2196;" ToolTip="Arriba a la izquierda" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosTop" Grid.Row="0" Grid.Column="2" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2191;" ToolTip="Arriba al centro" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosTopRight" Grid.Row="0" Grid.Column="4" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2197;" ToolTip="Arriba a la derecha" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosLeft" Grid.Row="2" Grid.Column="0" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2190;" ToolTip="Centro izquierda" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosCenter" Grid.Row="2" Grid.Column="2" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x25CF;" ToolTip="Centro de la pantalla" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosRight" Grid.Row="2" Grid.Column="4" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2192;" ToolTip="Centro derecha" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosBottomLeft" Grid.Row="4" Grid.Column="0" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2199;" ToolTip="Abajo a la izquierda" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosBottom" Grid.Row="4" Grid.Column="2" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2193;" ToolTip="Abajo al centro" Checked="Position_Checked"/>
                                <RadioButton x:Name="PosBottomRight" Grid.Row="4" Grid.Column="4" GroupName="Position" Style="{StaticResource CornerButton}" Content="&#x2198;" ToolTip="Abajo a la derecha" Checked="Position_Checked"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Alertas ================= -->
                <StackPanel x:Name="PageAlertas" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alertas" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Colores de alerta" Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="Pinta el valor en ámbar/rojo al superar los umbrales de cada métrica."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="AlertCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Umbrales por métrica" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Subida y Bajada no tienen un tope fijo de red: su % es relativo al pico reciente de cada una."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,-8,0,12" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="ThresholdsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RowHoverBrush}" CornerRadius="8" Margin="0,0,0,6" Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0" Data="{Binding IconGeometry}" Stroke="{Binding AccentBrush}" StrokeThickness="1.5"
                                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" FontSize="13.5"/>
                                                <ComboBox Grid.Column="2" SelectedIndex="0" SelectionChanged="ThresholdMode_Changed" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="Advertencia"/>
                                                    <ComboBoxItem Content="Crítico"/>
                                                </ComboBox>
                                                <Border Grid.Column="4" Background="#222833" CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding ThresholdEditValue, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                                                 FontFamily="Consolas" FontSize="12.5" VerticalContentAlignment="Center"
                                                                 HorizontalContentAlignment="Right" Padding="0,6,2,6"/>
                                                        <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Accesos rápidos ================= -->
                <StackPanel x:Name="PageAccesos" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Accesos rápidos" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Los atajos de teclado globales todavía no están implementados — por ahora, la única forma de abrir Ajustes o salir es desde el ícono de Vitals en la bandeja del sistema."
                                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Acerca de ================= -->
                <StackPanel x:Name="PageAcerca" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Image Source="vitals.ico" Width="40" Height="40"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Vitals" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="VersionText" Text="Versión —" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Monitor de recursos ligero para Windows: CPU, GPU, RAM, red y batería en una píldora siempre visible, construida en NativeAOT + Win32 + GDI+."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

              </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="#1D212A" CornerRadius="10" Padding="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <UniformGrid Columns="6" Rows="2">
                        <Button Style="{StaticResource PaletteSwatch}" Background="#4D8CFF" Tag="#4D8CFF" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#3DD67D" Tag="#3DD67D" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#A87FFF" Tag="#A87FFF" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#FF9F43" Tag="#FF9F43" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#56C4FF" Tag="#56C4FF" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#4CD964" Tag="#4CD964" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#FF6357" Tag="#FF6357" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#FFC154" Tag="#FFC154" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#FF6EC7" Tag="#FF6EC7" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#2DD4BF" Tag="#2DD4BF" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#F5F5F5" Tag="#F5F5F5" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteSwatch}" Background="#FFD447" Tag="#FFD447" Click="PaletteColor_Click"/>
                    </UniformGrid>
                    <Border Background="#222833" CornerRadius="6" Padding="0,8" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="ResetColor_Click">
                        <TextBlock Text="Restablecer color por defecto" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
